# ==============================================================================
# HUWA (High-Utility WhatsApp Agent) - Environment Configuration
# ==============================================================================

# Server Binding & Port
# Gunakan 0.0.0.0 untuk dedicated VPS Huwa (di-protect via UFW firewall ke IP WordPress)
# atau 127.0.0.1 jika dalam 1 VPS yang sama
HUWA_BIND=0.0.0.0
HUWA_PORT=8080

# Kunci Rahasia Otorisasi REST API Internal
# Wajib sama dengan pengaturan 'adv_huwa_secret' di solusi-wp
HUWA_SECRET=huwa_secret_auth_paling_aman_12345

# Direktori Penyimpanan SQLite Persistent Sesi
HUWA_DB_PATH=/var/lib/huwa/huwa.db

# Target Webhook Callback Default WordPress (solusi-wp)
HUWA_DEFAULT_WEBHOOK=http://127.0.0.1/wp-json/adv/v1/chatbot/webhook

# Batas Maksimal Sesi Device Aktif Bersamaan (Multi-Tenant)
HUWA_MAX_DEVICES=100

# Level Logging (debug, info, warn, error)
HUWA_LOG_LEVEL=info

# Anti-Banned & Human Presence Engine
HUWA_ANTI_BAN_ENABLED=true
HUWA_MIN_TYPING_DELAY=1500 # Milidetik (1.5 detik)
HUWA_MAX_TYPING_DELAY=4000 # Milidetik (4.0 detik)
HUWA_MIN_INTER_DELAY=2000   # Jeda minimal antar broadcast (2 detik)
HUWA_MAX_INTER_DELAY=6000   # Jeda maksimal antar broadcast (6 detik)
